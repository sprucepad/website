---
import trio from "@content/assets/trio.png";
import trioBanner from "@content/assets/trio.banner.png";
import pfp from "@content/assets/pfp.png";
import MouseIcon from "@lucide/astro/icons/mouse";

import BareLayout from "@/layouts/BareLayout.astro";
import { Content } from "./_about.md";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PixelArt from "@/components/ui/PixelArt.astro";
import { getCollection, getEntry } from "astro:content";
import { createAlbumMapper, sort } from "@/lib/collections";
import Album from "@/components/Album.svelte";
import { createCardMapper } from "@/lib/collections";
import Cards from "@/components/Cards.svelte";
import { getRelativeLocaleUrl } from "astro:i18n";
import Link from "@/components/ui/Link.astro";
import CopyrightNotice from "@/components/CopyrightNotice.astro";
import Article from "@/components/ui/Article.astro";

const locale = Astro.currentLocale!;

const albumMapper = createAlbumMapper(locale, 3);
const sketchbook = await getEntry("albums", "sketchbook")!.then(albumMapper);

const cardMapper = createCardMapper(locale);
const posts = await getCollection("posts")
  .then((a) => sort(a))
  .then((col) => Promise.all(col.map(cardMapper)));
const projects = await getCollection("projects")
  .then((a) => sort(a))
  .then((col) => Promise.all(col.map(cardMapper)));
---

<BareLayout
  title="sprucepad's website"
  desc="My personal website, showing my projects and my art."
>
  <main transition:name="main" transition:animate="slide">
    <section
      class="flex h-svh flex-col-reverse bg-white p-4 text-black lg:flex-row"
    >
      <div class="flex flex-1 justify-center">
        <PixelArt
          src={trio}
          alt="Three animal characters posing."
          class="hidden h-full w-fit object-contain lg:block"
        />
        <PixelArt
          src={trioBanner}
          loading="lazy"
          alt="Three animal characters posing."
          class="block h-full w-fit object-contain lg:hidden"
        />
      </div>
      <div
        class="flex flex-1 flex-col items-center justify-center gap-4 lg:items-start"
      >
        <h1
          class="flex flex-wrap items-center font-heading text-6xl font-black"
        >
          <PixelArt src={pfp} alt="" class="mx-auto" />
          sprucepad
        </h1>
        <p class="font-heading text-4xl font-black">Forrest's Stuff</p>

        <p class="flex animate-bounce gap-1 opacity-50">
          <MouseIcon /> Scroll down!
        </p>
      </div>

      <div class="absolute right-4 bottom-4 p-4">
        <CopyrightNotice />
      </div>
    </section>

    <Header variant="sticky" />

    <Article>
      <Content />
    </Article>

    <section class="space-y-4 p-16">
      <h1 class="font-heading text-4xl font-black">Sketches</h1>

      <Album
        album={sketchbook}
        empty="This isn't everything!"
        placeholder="Search sketches..."
        client:load
      />

      <Link class="underline" href="/gallery/sketchbook">More sketches...</Link>
    </section>

    <section class="space-y-4 p-16">
      <h1 class="font-heading text-4xl font-black">Posts</h1>

      <div>
        <Cards
          cards={posts.slice(0, 3)}
          href={getRelativeLocaleUrl(locale, "/blog")}
          empty="This isn't everything!"
          placeholder="Search posts..."
          client:load
        />
      </div>

      <Link class="underline" href="/blog">More posts...</Link>
    </section>

    <section class="space-y-4 p-16">
      <h1 class="font-heading text-4xl font-black">Projetos</h1>

      <div>
        <Cards
          cards={projects.slice(0, 3)}
          href={getRelativeLocaleUrl(locale, "/projects")}
          empty="This isn't everything!"
          placeholder="Pesquisar projetos..."
          client:load
        />
      </div>

      <Link class="underline" href="/projects">More projects...</Link>
    </section>
  </main>

  <Footer includeCopyrightNotice={false} />
</BareLayout>
