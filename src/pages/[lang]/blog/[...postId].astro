---
import Article from "@/components/ui/Article.astro";
import Layout from "@/layouts/Layout.astro";
import { unlocalize } from "@/lib/collections";
import { createTranslate } from "@/lib/i18n";
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Link from "@/components/ui/Link.astro";

export const getStaticPaths = (async () => {
  const posts = await getCollection("posts");
  return posts.map((post) => {
    const { lang, id } = unlocalize(post.id);
    return {
      params: { lang, postId: id },
      props: { post },
    };
  });
}) satisfies GetStaticPaths;

const { lang: locale } = Astro.params;
const { post } = Astro.props;

const table = {
  en: {
    title: "blog",
    license: "Licença",
    created: "Created",
    updated: "Updated",
    devlogFor: "Linked project",
  },
  pt: {
    title: "blog",
    license: "Licença",
    created: "Criado",
    updated: "Atualizado",
    devlogFor: "Projeto anexado",
  },
};
const t = createTranslate(locale, table);

const { Content } = await render(post);
const project =
  post.data.devlogFor &&
  (await getEntry(post.data.devlogFor.collection, post.data.devlogFor.id));
---

<Layout
  title={`${post.data.title} | ${t("title")} - sprucepad`}
  desc={post.data.desc}
  banner={post.data.image}
>
  <Article>
    <div slot="header" class="space-y-4 text-foreground">
      {
        post.data.image && (
          <Image src={post.data.image} alt="" class="rounded-lg" />
        )
      }
      <h1 class="font-heading text-4xl font-black">{post.data.title}</h1>
      <p>{post.data.desc}</p>

      {
        project && (
          <p class="underline">
            <Link href={`/projects/${unlocalize(project.id).id}`}>
              {t("devlogFor")}: {project.data.title}
            </Link>
          </p>
        )
      }
    </div>

    <Content />

    <ul slot="footer" class="ml-4 list-disc text-foreground">
      <li>
        {t("license")}: {post.data.license}
      </li>
      <li>
        {t("created")}: {post.data.createdAt.toLocaleDateString(locale)}
      </li>
      <li>
        {t("updated")}: {post.data.updatedAt.toLocaleDateString(locale)}
      </li>
    </ul>
  </Article>
</Layout>
