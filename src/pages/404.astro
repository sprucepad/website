---
import Layout from "@/layouts/Layout.astro";
import { buttonStyles } from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import { createTranslate } from "@/lib/i18n";

export const prerender = false;

const table = {
  pt: {
    title: "404 Não Encontrada",
    desc: "Essa página não existe!",
    button: "Página inicial",
  },
  en: {
    title: "404 Not Found",
    desc: "This page doesn't exist!",
    button: "Home page",
  },
};
const t = createTranslate(Astro.currentLocale, table);
---

<Layout
  title={t("title")}
  desc={t("desc")}
  class="grid min-h-svh place-content-center gap-4 p-4"
>
  <h1 class="text-center font-heading text-4xl font-black">
    {t("desc")}
  </h1>
  <Link class={buttonStyles()} href="/">{t("button")}</Link>
</Layout>
