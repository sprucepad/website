---
import pfp from "@content/assets/pfp.png";
import { cva, type VariantProps } from "class-variance-authority";
import InfoIcon from "@lucide/astro/icons/info";
import ContactIcon from "@lucide/astro/icons/contact";
import RSSIcon from "@lucide/astro/icons/rss";
import BrushIcon from "@lucide/astro/icons/brush";
import HammerIcon from "@lucide/astro/icons/hammer";
import MoonIcon from "@lucide/astro/icons/moon";
import SunIcon from "@lucide/astro/icons/sun";
import MenuIcon from "@lucide/astro/icons/menu";
import XIcon from "@lucide/astro/icons/x";

import Link from "./ui/Link.astro";
import PixelArt from "./ui/PixelArt.astro";
import { createTranslate } from "@/lib/i18n";

const table = {
  pt: {
    about: "Sobre",
    contact: "Contato",
    blog: "Blog",
    art: "Arte",
    projects: "Projetos",
  },
  en: {
    about: "About",
    contact: "Contact",
    blog: "Blog",
    art: "Art",
    projects: "Projects",
  },
};
const t = createTranslate(Astro.currentLocale, table);

const headerVariants = cva(
  "group top-2 left-2 z-50 flex grid h-fit w-[calc(100%-1rem)] grid-cols-2 place-content-center p-2 px-4 before:absolute before:inset-0 before:-z-50 before:rounded-lg before:bg-background/75 before:backdrop-blur-lg before:content-[''] md:grid-cols-3",
  {
    variants: {
      variant: {
        fixed: "fixed",
        sticky: "sticky mb-4",
      },
    },
    defaultVariants: {
      variant: "fixed",
    },
  },
);

type Props = VariantProps<typeof headerVariants>;
const { variant } = Astro.props;

const links = [
  { label: t("about"), href: "/", Icon: InfoIcon },
  { label: t("contact"), href: "/contact", Icon: ContactIcon },
  { label: t("blog"), href: "/blog", Icon: RSSIcon },
  { label: t("art"), href: "/art", Icon: BrushIcon },
  { label: t("projects"), href: "/projects", Icon: HammerIcon },
];
---

<header
  class={headerVariants({ variant })}
  id="header"
  transition:name="header"
  transition:animate="fade"
>
  <div>
    <Link
      href="/"
      class="flex w-fit items-center font-heading text-2xl font-black"
    >
      <PixelArt src={pfp} width={48} height={48} alt="" />
      sprucepad
    </Link>
  </div>

  <nav
    class="fixed top-20 right-2 flex translate-x-[calc(100%+1rem)] transform items-center rounded-lg bg-background/75 p-2 backdrop-blur-lg transition-transform group-data-open:translate-x-0 md:static md:translate-x-0 md:bg-transparent md:p-0 md:backdrop-blur-none"
    transition:animate="fade"
  >
    <ul class="flex flex-col md:flex-row">
      {
        links.map((link) => {
          const pathname = Astro.url.pathname.replace(
            `${Astro.currentLocale}/`,
            "",
          );
          const isSelected =
            link.href === "/"
              ? pathname === link.href
              : pathname.startsWith(link.href);
          return (
            <li
              class="block w-full rounded-lg p-2 hover:underline data-selected:bg-accent data-selected:text-accent-foreground"
              data-selected={isSelected ? true : undefined}
            >
              <Link href={link.href} class="flex w-full gap-1">
                <link.Icon /> {link.label}
              </Link>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="flex items-center justify-end gap-2">
    <div id="headerToggle" class="md:hidden">
      <MenuIcon class="group-data-open:hidden" />
      <XIcon class="hidden group-data-open:block" />
    </div>
    <div id="theme" class="cursor-pointer">
      <MoonIcon class="dark:hidden" />
      <SunIcon class="hidden dark:block" />
    </div>
  </div>
</header>

<script>
  let theme =
    localStorage.getItem("theme") ??
    (window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light");

  document.addEventListener("astro:page-load", () => {
    document.documentElement.dataset.theme = theme;

    const $theme = document.getElementById("theme");
    $theme?.addEventListener("click", () => {
      theme = theme === "dark" ? "light" : "dark";
      localStorage.setItem("theme", theme);
      document.documentElement.dataset.theme = theme;
    });

    const $header = document.getElementById("header");
    const $headerToggle = document.getElementById("headerToggle");
    $headerToggle?.addEventListener("click", () => {
      $header?.toggleAttribute("data-open");
    });
  });
</script>
