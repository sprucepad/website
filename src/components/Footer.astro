---
import { createTranslate } from "@/lib/i18n";
import Link from "./ui/Link.astro";

const locale = Astro.currentLocale!;

const table = {
  pt: {
    licenses: "Verifique as licenças.",
  },
  en: {
    licenses: "Check licensing.",
  },
};
const t = createTranslate(locale, table);

interface Props {
  includeCopyrightNotice?: boolean;
}

const { includeCopyrightNotice = true } = Astro.props;
---

<footer
  class="mx-auto w-fit space-y-4 p-4 opacity-50"
  transition:name="footer"
  transition:animate="slide"
>
  <select id="languageSwitcher" class="mx-auto block">
    <option value="pt" selected={locale === "pt"}>Português</option>
    <option value="en" selected={locale === "en"}>English</option>
  </select>

  {
    includeCopyrightNotice && (
      <p class="text-center">
        Copyright &copy; 2025-{new Date().getFullYear()} sprucepad.{" "}
        <Link class="underline" href="/licensing">
          {t("licenses")}
        </Link>
      </p>
    )
  }
</footer>

<script>
  import { navigate } from "astro:transitions/client";

  document.addEventListener("astro:page-load", () => {
    const $languageSwitcher = document.getElementById("languageSwitcher");

    $languageSwitcher?.addEventListener("change", () => {
      const currentPathname = location.pathname.split("/").slice(2).join("/");
      navigate(
        `/${($languageSwitcher as HTMLSelectElement).value}/${currentPathname}`,
      );
    });
  });
</script>
