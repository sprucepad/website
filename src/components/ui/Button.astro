---
import { cn } from "@/lib/utils";
import type { HTMLTag, Polymorphic } from "astro/types";
import { cva, type VariantProps } from "class-variance-authority";

export const buttonStyles = cva(
  "w-full transform cursor-pointer p-2 text-center font-heading font-black uppercase transition-[box-shadow,translate] hover:translate-y-0.25 active:translate-y-0.5",
  {
    variants: {
      variant: {
        standard:
          "rounded-lg border-2 border-foreground bg-accent text-accent-foreground shadow-neobrutal hover:shadow-neobrutal-sm active:shadow-none",
      },
      size: {
        sm: "",
      },
    },
    defaultVariants: {
      variant: "standard",
      size: "sm",
    },
  },
);

type Props<T extends HTMLTag = "button"> = Polymorphic<{ as: T }> &
  VariantProps<typeof buttonStyles>;

const {
  as: Tag = "button",
  class: className,
  variant,
  size,
  ...rest
} = Astro.props;
---

<Tag class={cn(buttonStyles({ variant, size }), className)} {...rest}
  ><slot /></Tag
>
