---
import { cn } from "@/lib/utils";
import type { HTMLTag, Polymorphic } from "astro/types";
import { cva, type VariantProps } from "class-variance-authority";

export const buttonStyles = cva("rounded-full bg-red-400 p-2 text-center", {
  variants: {
    variant: {
      standard: "",
    },
    size: {
      sm: "",
    },
  },
  defaultVariants: {
    variant: "standard",
    size: "sm",
  },
});

type Props<T extends HTMLTag> = Polymorphic<{ as: T }> &
  VariantProps<typeof buttonStyles>;

const {
  as: Tag = "button",
  class: className,
  variant,
  size,
  ...rest
} = Astro.props;
---

<Tag class={cn(buttonStyles({ variant, size }), className)} {...rest}
  ><slot /></Tag
>
