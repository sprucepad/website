---
import { cn } from "@/lib/utils";
import type { HTMLTag, Polymorphic } from "astro/types";
import { cva, type VariantProps } from "class-variance-authority";

export const buttonStyles = cva(
  "w-full transform bg-accent p-2 text-center text-accent-foreground transition-transform hover:translate-y-0.25 active:translate-y-0.5",
  {
    variants: {
      variant: {
        standard:
          "art:rounded-full art:border-2 art:border-foreground art:shadow-neobrutal",
      },
      size: {
        sm: "",
      },
    },
    defaultVariants: {
      variant: "standard",
      size: "sm",
    },
  },
);

type Props<T extends HTMLTag> = Polymorphic<{ as: T }> &
  VariantProps<typeof buttonStyles>;

const {
  as: Tag = "button",
  class: className,
  variant,
  size,
  ...rest
} = Astro.props;
---

<Tag class={cn(buttonStyles({ variant, size }), className)} {...rest}
  ><slot /></Tag
>
