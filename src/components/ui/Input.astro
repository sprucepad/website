---
import { cn } from "@/lib/utils";
import type { HTMLTag, Polymorphic } from "astro/types";
import { cva, type VariantProps } from "class-variance-authority";

const inputStyles = cva(
  "w-full transform p-2 transition-[box-shadow,translate] hover:translate-y-0.25",
  {
    variants: {
      variant: {
        standard:
          "foxus:shadow-none rounded-lg border-2 border-foreground shadow-neobrutal hover:shadow-neobrutal-sm",
      },
    },
    defaultVariants: {
      variant: "standard",
    },
  },
);

type Props<T extends HTMLTag = "input"> = Polymorphic<{ as: T }> &
  VariantProps<typeof inputStyles>;

const { as: Tag = "input", class: className, variant, ...rest } = Astro.props;
---

<Tag class={cn(inputStyles({ variant }), className)} {...rest}><slot /></Tag>
