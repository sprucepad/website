---
import { cn } from "@/lib/utils";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"article">;

const { class: className, ...rest } = Astro.props;
---

<article
  class={cn(
    "mx-auto prose p-4 prose-neutral dark:prose-invert prose-headings:font-heading",
    className,
  )}
  {...rest}
>
  <header class="not-prose"><slot name="header" /></header>
  <slot />
  <footer class="not-prose"><slot name="footer" /></footer>
</article>
