---
import type { HTMLAttributes } from "astro/types";
import BareLayout, { type LayoutProps } from "./BareLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props
  extends LayoutProps, Omit<HTMLAttributes<"main">, keyof LayoutProps> {}

const { title, desc, banner, ...rest } = Astro.props;
---

<BareLayout title={title} desc={desc} banner={banner}>
  <Header />
  <main {...rest}>
    <slot />
  </main>
  <Footer />
</BareLayout>
