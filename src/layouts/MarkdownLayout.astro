---
import type { MarkdownLayoutProps } from "astro";
import Layout, { type LayoutProps } from "./Layout.astro";

type Props = MarkdownLayoutProps<LayoutProps>;

const { frontmatter } = Astro.props;
---

<Layout {...frontmatter}>
  <article
    class="mx-auto prose py-32 prose-zinc prose-headings:font-heading code:prose-invert"
  >
    <slot />
  </article>
</Layout>
